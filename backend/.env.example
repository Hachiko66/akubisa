# Salin ke .env (jangan commit .env — file ini hanya contoh).
# Email dikirim lewat Resend SMTP (layanan transaksional), BUKAN Gmail:
# Gmail menimpa header `from` dengan akun login SMTP, sehingga semua email
# terkirim dari email pribadi pemilik akun.
#
# Langkah setup (sekali saja):
#   1. Buat akun di https://resend.com (gratis: 3.000 email/bulan, 100/hari,
#      tanpa kartu kredit).
#   2. Di dashboard Resend: Domains -> Add Domain -> akubisa.co, lalu tambah
#      3 record DNS yang ditampilkan Resend (SPF, DKIM, return-path/MX) di
#      DNS domain akubisa.co, lalu klik Verify (biasanya <15 menit).
#   3. Di dashboard Resend: API Keys -> Create API Key, salin kuncinya
#      (diawali re_) ke EMAIL_PASS di bawah. JANGAN taruh kunci di repo.
#   4. Restart backend (PM2) agar .env baru terbaca.

EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=AkuBisa <noreply@akubisa.co>

# ===== PEMBAYARAN SOLANA + USDC (satu-satunya rel bayar) =====
# Semua gateway fiat (Pakasir, Duitku, Xendit) sudah dihapus dari kode.
# Client membayar USDC ke wallet escrow; backend memverifikasi on-chain.
#
# Jaringan: default devnet (aman untuk tes). Untuk produksi isi:
#   SOLANA_NETWORK=mainnet-beta
#   SOLANA_RPC_URL=<RPC mainnet kamu, mis. Helius/QuickNode — JANGAN pakai
#     RPC publik untuk produksi, rate-limit-nya ketat>
#   USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Untuk devnet (default), kosongkan ketiga baris di atas.
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#
# Alamat escrow (public key — AMAN ditampilkan ke client sebagai alamat
# tujuan bayar). Isi dengan alamat publik keypair escrow produksi.
ESCROW_SOLANA_ADDRESS=
#
# Path file keypair escrow (PRIVATE KEY). JANGAN PERNAH isi nilainya di
# file ini, di repo, atau di chat — hanya PATH-nya. File berisi JSON
# array 64 byte (format Solana CLI), mode 600, milik user yang
# menjalankan backend (mis. /var/www/akubisa/escrow-keypair.json).
# Keypair ini memegang DANA USER — baca docs/pembayaran-solana.md
# sebelum membuat/menyimpannya. Tanpa file ini, pembayaran dan withdraw
# GAGAL TERTUTUP (503), server tetap jalan untuk fitur lain.
ESCROW_KEYPAIR_PATH=/var/www/akubisa/escrow-keypair.json
#
# Fee platform (% dari nilai transaksi, dibebankan ke client di atas
# harga worker). Default 10 (naik dari 5 per keputusan 2026-11-23).
PLATFORM_FEE_PERCENT=10
#
# Kurs fallback (Rp per 1 USDC) bila CoinGecko tidak bisa dihubungi saat
# transaksi dibuat. Kosongkan = transaksi gagal tertutup bila CoinGecko
# down (lebih aman daripada mengunci kurs basi). Bila diisi, pastikan
# nilainya diperbarui berkala — kurs basi merugikan platform/client.
# USDC_IDR_FALLBACK_RATE=16300
